# AI Model Configuration

# GPU Support (RTX 4060 için önerilir)
# true: GPU kullan (çok daha hızlı)
# false: CPU kullan
USE_GPU=true

# Summarization Model
# Seçenekler:
# - facebook/bart-large-cnn (varsayılan, İngilizce odaklı, 1.6GB)
# - sshleifer/distilbart-cnn-12-6 (hızlı, İngilizce, 769MB)
# - facebook/mbart-large-50 (çok dilli, Türkçe desteği, 2.4GB)
SUMMARY_MODEL=facebook/bart-large-cnn

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Configuration (opsiyonel - embedding-based chunk selection için)
# false: Direkt özetleme (daha hızlı)
# true: Embedding-based chunk seçimi (daha kaliteli ama yavaş)
USE_CHROMA=false

# AI Provider Selection
# local: Run transformer models inside this app container
# external: Use an external OpenAI-compatible API endpoint
AI_PROVIDER=local

# External LLM Configuration (used when AI_PROVIDER=external)
EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
EXTERNAL_LLM_ENDPOINT=/chat/completions
EXTERNAL_LLM_MODEL=gpt-4o-mini
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_TIMEOUT_SECONDS=90
EXTERNAL_LLM_MAX_INPUT_CHARS=24000

# ChromaDB Settings (sadece USE_CHROMA=true ise gerekli)
CHROMA_HOST=api.trychroma.com
CHROMA_PORT=443
CHROMA_SSL=true
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=ozet_chunks
